# Copy this file to `.env` and fill in your Binance SPOT TESTNET credentials.
# Get testnet-only keys by logging in with GitHub at https://testnet.binance.vision/
#
# SAFETY:
# - These must be TESTNET keys only. Testnet keys cannot be used against
#   production Binance endpoints, and this codebase never sends them there
#   (the production host is not reachable from any order-placing code path).
# - Never request, grant, or use withdrawal permission on any key used here.
# - Never commit a real .env file. It is excluded via .gitignore.

BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Optional: shadow-mode Telegram notifications (see config/shadow.yaml's
# telegram.enabled and shadow/notifications/). Leave unset/blank to keep
# notifications off - shadow trading works identically either way. Never
# commit real values; get a bot token from @BotFather and your numeric
# chat ID from @userinfobot (see README.md's Shadow mode section).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
